---
type UkuranKode = 'XS' | 'S' | 'M' | 'L';

interface Props {
  tersedia?: boolean;
  ukuranTersedia?: readonly UkuranKode[];
}

const { tersedia = true, ukuranTersedia = ['XS', 'S', 'M', 'L'] } = Astro.props;
const setUkuran = new Set<UkuranKode>(ukuranTersedia);

const DAFTAR_UKURAN = [
  { kode: 'XS' as const, jempol: 14, telunjuk: 10, tengah: 11, manis: 10, kelingking: 8 },
  { kode: 'S' as const, jempol: 15, telunjuk: 11, tengah: 12, manis: 11, kelingking: 9 },
  { kode: 'M' as const, jempol: 16, telunjuk: 12, tengah: 13, manis: 12, kelingking: 9 },
  { kode: 'L' as const, jempol: 17, telunjuk: 13, tengah: 14, manis: 13, kelingking: 10 },
];
---

<div class="mt-6" data-size-chart>
  {
    tersedia && (
      <div class="mb-5">
        <div class="flex items-center justify-between">
          <span class="text-xs tracking-widest text-teks-redup uppercase">
            Available Size
          </span>
          <span class="text-xs text-teks-redup" data-ukuran-terpilih>
            Belum dipilih
          </span>
        </div>

        <div class="mt-2.5 grid grid-cols-4 gap-2" role="group" aria-label="Pilih ukuran kuku">
          {DAFTAR_UKURAN.map((u) => {
            const ada = setUkuran.has(u.kode);
            return (
              <button
                type="button"
                data-pilih-ukuran={u.kode}
                aria-pressed="false"
                disabled={!ada}
                title={ada ? `Pilih ukuran ${u.kode}` : `Ukuran ${u.kode} habis`}
                class:list={[
                  'min-h-11 rounded border px-3 py-2 text-xs font-medium tracking-wider transition-colors',
                  ada
                    ? 'cursor-pointer border-garis bg-latar text-teks hover:border-aksen'
                    : 'cursor-not-allowed border-garis bg-latar-2 text-teks-redup line-through opacity-45',
                ]}
              >
                {u.kode}
              </button>
            );
          })}
        </div>
      </div>
    )
  }

  <div class="border border-garis bg-latar-2 p-4">
    <div class="flex items-baseline justify-between gap-2">
      <h2 class="text-xs font-medium tracking-widest text-teks uppercase">
        Size Chart
      </h2>
      <span class="text-[11px] text-teks-redup">Satuan: milimeter (mm)</span>
    </div>

    <div class="mt-3 overflow-x-auto">
      <table class="w-full border-collapse text-center text-xs">
        <thead>
          <tr class="border-b border-garis text-[11px] tracking-wide text-teks-redup uppercase">
            <th class="py-2 pr-2 text-left font-medium">Size</th>
            <th class="px-2 py-2 font-medium">Jempol</th>
            <th class="px-2 py-2 font-medium">Telunjuk</th>
            <th class="px-2 py-2 font-medium">Tengah</th>
            <th class="px-2 py-2 font-medium">Manis</th>
            <th class="py-2 pl-2 font-medium">Kelingking</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-garis">
          {DAFTAR_UKURAN.map((u) => {
            const ada = setUkuran.has(u.kode);
            return (
              <tr
                data-baris-ukuran={u.kode}
                class:list={['transition-colors', !ada && 'opacity-45']}
              >
                <td class:list={['py-2 pr-2 text-left font-medium text-teks', !ada && 'line-through']}>
                  {u.kode}
                </td>
                <td class="px-2 py-2 text-teks-redup">{u.jempol}</td>
                <td class="px-2 py-2 text-teks-redup">{u.telunjuk}</td>
                <td class="px-2 py-2 text-teks-redup">{u.tengah}</td>
                <td class="px-2 py-2 text-teks-redup">{u.manis}</td>
                <td class="py-2 pl-2 text-teks-redup">{u.kelingking}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-3 text-[11px] leading-relaxed text-teks-redup">
      Ukur bagian terlebar kuku asli dari sisi ke sisi menggunakan penggaris atau pita ukur.
    </p>
  </div>
</div>
